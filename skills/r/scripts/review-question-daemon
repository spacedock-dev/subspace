#!/usr/bin/env bash
set -uo pipefail

# This adapter owns only process launch and stream capture. Go owns daemon
# identity, liveness classification, terminal choice, and result precedence.

daemon_fail() {
  printf 'review-question-daemon: %s\n' "$1" >&2
  exit 2
}

[[ $# -ge 1 ]] || daemon_fail 'usage: review-question-daemon RUN [--grace S] [--transport-bin PATH] -- entry-argv...'
run=$1
shift
[[ -d $run ]] || daemon_fail "no such run directory: $run"
[[ -f $run/config.json ]] || daemon_fail "not a question run directory: $run"

grace=3
transport_bin=${SUBSPACE_TUI_BIN:-}
while [[ $# -gt 0 ]]; do
  case $1 in
    --grace)
      [[ $# -ge 2 ]] || daemon_fail 'grace requires a whole number of seconds'
      grace=$2
      shift 2
      ;;
    --transport-bin)
      [[ $# -ge 2 ]] || daemon_fail 'transport binary path is required'
      transport_bin=$2
      shift 2
      ;;
    --)
      shift
      break
      ;;
    *)
      daemon_fail "unknown option: $1"
      ;;
  esac
done
[[ $# -ge 1 ]] || daemon_fail 'no entry command given after --'
[[ $grace =~ ^[0-9]+$ ]] || daemon_fail 'grace must be a whole number of seconds'
if [[ -z $transport_bin ]]; then
  transport_bin=$(command -v subspace-tui 2>/dev/null) || daemon_fail 'subspace-tui is unavailable'
fi
[[ -x $transport_bin ]] || daemon_fail 'subspace-tui transport binary is not executable'

# The launcher is the only child this script creates. Its stdout and stderr are
# the durable facts consumed by the Go supervisor.
set -m
(
  "$@" > "$run/trusted-result.json" 2> "$run/launcher.stderr"
  status=$?
  printf '{"exit":%d}\n' "$status" > "$run/launcher-exit"
) &
launcher_pid=$!
set +m
printf '%s\n' "$launcher_pid" > "$run/launcher.pid"

exec "$transport_bin" --question-transport supervise --run "$run" \
  --launcher-pid "$launcher_pid" --grace "$grace"

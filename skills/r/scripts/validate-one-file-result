#!/usr/bin/env bash
set -euo pipefail

if [[ ${1:-} == --review-v1 ]]; then
  [[ $# == 10 ]] || {
    printf 'usage: validate-one-file-result --review-v1 <briefing-file> <sha256-revision> <actor> <mode> <result> <log> <inventory> <child-exit> <capture>\n' >&2
    exit 2
  }
  package=$2
  revision=$3
  actor=$4
  # The declared mode arrives from the invocation. It is never read from the
  # Result being audited: that Result's author is exactly what this script is
  # checking, and trusting its own claim would delete the cross-check that
  # previously caught a forged binding envelope at exit 0.
  declared_mode=$5
  case $declared_mode in
    feedback | advisory | binding) ;;
    *) exit 20 ;;
  esac
  result=$6
  log=$7
  inventory=$8
  child_exit=$9
  capture=${10}
  for path in "$package" "$result" "$log" "$inventory" "$child_exit" "$capture"; do
    [[ $path == /* && -f $path && ! -L $path ]] || exit 20
  done
  [[ $revision =~ ^sha256:[0-9a-f]{64}$ ]] || exit 20
  [[ sha256:$(shasum -a 256 "$package" | awk '{print $1}') == "$revision" ]] || exit 20
  cmp -s -- "$result" "$capture" || exit 20
  jq -e '.exit == 0 and (.argvSha256 | test("^sha256:[0-9a-f]{64}$")) and
    (keys | sort) == (["argvSha256","exit"] | sort)' "$child_exit" >/dev/null
  argv=${child_exit%/*}/argv.json
  [[ -f $argv && ! -L $argv ]] || exit 20
  argv_digest=sha256:$(shasum -a 256 "$argv" | awk '{print $1}')
  [[ $(jq -r '.argvSha256' "$child_exit") == "$argv_digest" ]] || exit 20
  jq -e --arg package "$package" --arg actor "$actor" --arg mode "$declared_mode" \
    --arg result "$result" --arg log "$log" --arg inventory "$inventory" '
      length == 9 and .[1:] == ["--review-v1","--actor",$actor,"--mode",$mode,
        "--provider-package",($result | sub("/result.json$"; "")),$package]
  ' "$argv" >/dev/null || exit 20
  briefing=$(jq -er '.id | select(type == "string" and length > 0)' "$package")
  jq -e --slurpfile package "$package" --arg briefing "$briefing" '
    def context_nodes:
      if type == "object" then
        ., (. as $node | ($node | keys | sort)[] as $key | $node[$key] | context_nodes)
      elif type == "array" then .[] | context_nodes
      else empty end;
    def projected:
      [($package[0].artifacts[] | {type:"Artifact",id,uri,mediaType,rev})] +
      [($package[0].context[] | context_nodes |
        select(.type == "Reference" and (.id | type == "string" and length > 0)) |
        {type:"Reference",id,uri,mediaType:(.mediaType // ""),rev:(.rev // "")})];
    type == "object" and (keys | sort) == (["type","version","briefing","question","items"] | sort) and
    .type == "subspace-presented-inventory" and .version == "1" and
    ($package[0].question | type == "string" and length > 0) and
    .briefing == $briefing and .question == $package[0].question and .items == projected and
    ([.items[].id] | unique | length) == (.items | length)
  ' "$inventory" >/dev/null || exit 20
  jq -s -e --slurpfile package "$package" --slurpfile entries "$log" \
    --arg briefing "$briefing" --arg actor "$actor" --arg mode "$declared_mode" --arg log "$log" '
    def nonempty: type == "string" and length > 0;
    def includes: ((.includes // []) | type == "array" and all(.[]; nonempty) and
      ((unique | length) == length));
    def decision: (.decision == "approve" or .decision == "revise" or .decision == "hold") and
      includes and (if .decision == "approve" then true else ((.reason // "") | length > 0) or ((.includes // []) | length > 0) end);
    def open:
      (keys | sort) == (["type","status","briefing","log"] | sort) and
      .type == "review-v1-open-result" and .status == "open" and
      .briefing == $briefing and .log == $log;
    def feedback_completed:
      (keys | sort) == (["type","mode","briefing","artifact","annotations","actor"] | sort) and
      .type == "review-v1-result" and .mode == $mode and .briefing == $briefing and
      .artifact == $package[0].artifacts[0] and .actor == $actor and
      .annotations == [$entries[] | select(.type == "Annotation")] and
      ($entries | map(select(.type == "Resolution")) | length) == 0;
    def decision_completed:
      (keys | sort) == (["type","mode","briefing","artifact","annotations","resolution",
        "binding","actor","resolutionId","decision","reason","includes"] | sort) and
      .type == "review-v1-result" and .mode == $mode and .briefing == $briefing and
      .artifact == $package[0].artifacts[0] and .actor == $actor and
      .annotations == [$entries[] | select(.type == "Annotation")] and
      .resolution == ($entries | map(select(.type == "Resolution"))[-1]) and
      .decision == .resolution.decision and
      .reason == (.resolution.reason // "") and .includes == (.resolution.includes // []) and
      .resolution.briefing == $briefing and .resolution.by == $actor and decision and
      .resolutionId == .resolution.id and .binding == ($mode == "binding");
    def completed:
      if $mode == "feedback" then feedback_completed else decision_completed end;
    length == 1 and (.[0] | type == "object") and
    if (.[0] | has("open")) then
      (.[0] | (keys | sort) == ["open"]) and (.[0].open | open)
    else (.[0] | completed) end
  ' "$capture" >/dev/null || exit 20
  if [[ $declared_mode != feedback ]] && jq -e '.type == "review-v1-result"' "$capture" >/dev/null; then
    jq -s -e --arg briefing "$briefing" --arg actor "$actor" --argjson result "$(jq -c '.resolution' "$capture")" '
      length > 0 and .[-1].type == "Resolution" and .[-1].briefing == $briefing and
      .[-1].by == $actor and .[-1].decision == $result.decision and
      ((.[-1].reason // "") == ($result.reason // "")) and
      ((.[-1].includes // []) == ($result.includes // [])) and
      (.[-1].id | length > 0) and .[-1].id == $result.id
    ' "$log" >/dev/null || exit 20
  fi
  cat -- "$capture"
  exit 0
fi

[[ $# == 5 ]] || {
  printf 'usage: validate-one-file-result <absolute-file.md> <sha256-revision> <mode> <absolute-result.json> <absolute-capture.json>\n' >&2
  exit 2
}
artifact=$1
revision=$2
# Same rule as the provider profile: the expected mode comes from the
# invocation, never from the Result under audit.
declared_mode=$3
result=$4
capture=$5
case $declared_mode in
  feedback | advisory | binding) ;;
  *) exit 20 ;;
esac

[[ $artifact == /* && $result == /* && $capture == /* ]] || exit 20
[[ -f $result && ! -L $result && -f $capture && ! -L $capture ]] || exit 20
[[ $revision =~ ^sha256:[[:xdigit:]]{64}$ ]] || exit 20
cmp -s -- "$result" "$capture" || exit 20

result_mode=$(stat -f '%Lp' "$result" 2>/dev/null || stat -c '%a' "$result" 2>/dev/null) || exit 20
[[ $result_mode == 600 ]] || exit 20
briefing_hash=$(printf 'subspace:one-file-invocation:v1\0%s' "$result" | shasum -a 256 | awk '{print $1}')
briefing=briefing:single-file:$(printf '%.32s' "$briefing_hash")

jq -s -e --arg artifact "$artifact" --arg revision "$revision" --arg briefing "$briefing" --arg mode "$declared_mode" '
  def exact_keys($want): (keys | sort) == ($want | sort);
  def nonempty: type == "string" and length > 0;
  def selector:
    type == "object" and
    (all(keys[]; . == "type" or . == "exact" or . == "prefix" or . == "suffix")) and
    .type == "TextQuoteSelector" and (.exact | nonempty) and
    ((has("prefix") | not) or (.prefix | type == "string")) and
    ((has("suffix") | not) or (.suffix | type == "string"));
  def annotation:
    type == "object" and
    (all(keys[]; . == "type" or . == "id" or . == "briefing" or . == "by" or
      . == "at" or . == "target" or . == "selectors" or . == "kind" or
      . == "body" or . == "original" or . == "proposed")) and
    .type == "Annotation" and (.id | nonempty) and .briefing == $briefing and
    .by == "person:reviewer" and (.at | nonempty) and .target == "artifact:primary" and
    ((has("selectors") | not) or ((.selectors | type) == "array" and all(.selectors[]; selector))) and
    if .kind == "comment" then
      (.body | nonempty) and (has("original") | not) and (has("proposed") | not)
    elif .kind == "suggestion" then
      (.original | type == "string") and (.proposed | type == "string") and
      (.selectors | type == "array" and length > 0) and (has("body") | not)
    else false end;
  def artifact_identity:
    exact_keys(["id","uri","mediaType","rev"]) and
    . == {id:"artifact:primary",uri:$artifact,mediaType:"text/markdown",rev:$revision};
  def annotations_ok:
    (.annotations | type == "array") and all(.annotations[]; annotation) and
    (([.annotations[].id] | unique | length) == (.annotations | length));
  def feedback:
    exact_keys(["type","mode","briefing","artifact","annotations","actor"]) and
    .type == "review-v1-result" and .mode == $mode and $mode == "feedback" and
    .briefing == $briefing and
    (.artifact | artifact_identity) and .actor == "person:reviewer" and annotations_ok;
  def resolution_entry:
    type == "object" and
    (all(keys[]; . == "type" or . == "id" or . == "briefing" or . == "by" or
      . == "at" or . == "decision" or . == "reason" or . == "includes")) and
    .type == "Resolution" and (.id | nonempty) and .briefing == $briefing and
    .by == "person:reviewer" and (.at | nonempty) and
    (.decision == "approve" or .decision == "revise" or .decision == "hold");
  def decision_result:
    exact_keys(["type","mode","briefing","artifact","annotations","resolution",
      "binding","actor","resolutionId","decision","reason","includes"]) and
    .type == "review-v1-result" and .mode == $mode and
    ($mode == "advisory" or $mode == "binding") and
    .briefing == $briefing and (.artifact | artifact_identity) and
    .actor == "person:reviewer" and annotations_ok and
    (.resolution | resolution_entry) and
    .binding == ($mode == "binding") and
    .resolutionId == .resolution.id and .decision == .resolution.decision and
    .reason == (.resolution.reason // "") and
    .includes == (.resolution.includes // []) and
    (.includes | type == "array" and ((unique | length) == length));
  def open($root):
    exact_keys(["type","status","briefing","artifact","package","log"]) and
    .type == "review-v1-open-result" and .status == "open" and .briefing == $briefing and
    (.artifact | artifact_identity) and
    (.package | nonempty and startswith("/") and
      (split("/")[1:] | length > 0 and all(.[]; length > 0 and . != "." and . != ".."))) and
    (.log | nonempty and . == ($root.package + "/briefing.review.jsonl"));
  if length != 1 or (.[0] | type) != "object" then error("exactly one result object is required")
  else .[0] as $root |
    if ($root | feedback) or ($root | decision_result) or ($root | open($root)) then true
    else error("invalid one-file result") end
  end
' "$capture" >/dev/null || exit 20

[[ $(head -c 1 "$capture") == '{' ]] || exit 20
last_byte=$(tail -c 1 "$capture" | od -An -t x1 | tr -d ' ')
if [[ $last_byte == 0a ]]; then
  [[ $(tail -c 2 "$capture" | head -c 1) == '}' ]] || exit 20
else
  [[ $last_byte == 7d ]] || exit 20
fi

if [[ $(jq -r '.status' "$capture") == open ]]; then
  package=$(jq -r '.package' "$capture")
  log=$(jq -r '.log' "$capture")
  [[ -d $package && ! -L $package ]] || exit 20
  package_mode=$(stat -f '%Lp' "$package" 2>/dev/null || stat -c '%a' "$package" 2>/dev/null) || exit 20
  [[ $package_mode == 700 ]] || exit 20
  briefing_path=$package/briefing.json
  snapshot_path=$package/artifact.md
  [[ -f $briefing_path && ! -L $briefing_path && -f $snapshot_path && ! -L $snapshot_path ]] || exit 20
  briefing_mode=$(stat -f '%Lp' "$briefing_path" 2>/dev/null || stat -c '%a' "$briefing_path" 2>/dev/null) || exit 20
  snapshot_mode=$(stat -f '%Lp' "$snapshot_path" 2>/dev/null || stat -c '%a' "$snapshot_path" 2>/dev/null) || exit 20
  [[ $briefing_mode == 600 && $snapshot_mode == 600 ]] || exit 20
  snapshot_revision=sha256:$(shasum -a 256 "$snapshot_path" | awk '{print $1}')
  [[ $snapshot_revision == "$revision" ]] || exit 20
  jq -s -e --arg briefing "$briefing" --arg artifact "$artifact" --arg revision "$revision" '
    length == 1 and (.[0] |
      type == "object" and (keys | sort) == (["type","version","id","question","artifacts","context"] | sort) and
      .type == "Briefing" and .version == "1" and .id == $briefing and
      .question == "What should the requester know about this artifact?" and .context == [] and
      .artifacts == [{id:"artifact:primary",uri:$artifact,mediaType:"text/markdown",rev:$revision}])
  ' "$briefing_path" >/dev/null || exit 20
  if [[ -e $log || -L $log ]]; then
    [[ -s $log && -f $log && ! -L $log ]] || exit 20
    log_mode=$(stat -f '%Lp' "$log" 2>/dev/null || stat -c '%a' "$log" 2>/dev/null) || exit 20
    [[ $log_mode == 600 ]] || exit 20
    jq -s -e --arg briefing "$briefing" '
      def nonempty: type == "string" and length > 0;
      def selector: type == "object" and
        (all(keys[]; . == "type" or . == "exact" or . == "prefix" or . == "suffix")) and
        .type == "TextQuoteSelector" and (.exact | nonempty) and
        ((has("prefix") | not) or (.prefix | type == "string")) and
        ((has("suffix") | not) or (.suffix | type == "string"));
      def annotation: type == "object" and
        (all(keys[]; . == "type" or . == "id" or . == "briefing" or . == "by" or . == "at" or . == "target" or . == "selectors" or . == "kind" or . == "body" or . == "original" or . == "proposed")) and
        .type == "Annotation" and (.id | nonempty) and .briefing == $briefing and .by == "person:reviewer" and
        (.at | nonempty) and .target == "artifact:primary" and
        ((has("selectors") | not) or ((.selectors | type) == "array" and all(.selectors[]; selector))) and
        if .kind == "comment" then (.body | nonempty) and (has("original") | not) and (has("proposed") | not)
        elif .kind == "suggestion" then (.original | type == "string") and (.proposed | type == "string") and (.selectors | type == "array" and length > 0) and (has("body") | not)
        else false end;
      length > 0 and all(.[]; annotation) and (([.[].id] | unique | length) == length)
    ' "$log" >/dev/null || exit 20
  fi
fi

cat -- "$capture"

#!/usr/bin/env bash

# Private lifecycle sourced by each fixed review-* entry. Host selection and
# host commands stay in the entry; result interpretation stays in the one
# canonical validator executable. Everything between them -- profile grammar,
# Artifact pinning, scratch population, child argv, completion detection,
# result capture -- belongs to subspace-tui, behind --invocation-prepare,
# --invocation-finish and --invocation-cleanup. What is left here must run in
# the calling shell's own process: the trap spanning host dispatch, the
# scratch allocated before a Go process exists to own it, and the CLI grammar
# the six fixed entries share.

# Portable file mode (macOS/BSD stat vs GNU stat), used only by the private
# initial-question-file leg below to enforce mode 0600 on the seed file.
invocation_path_mode() {
  local mode
  if mode=$(stat -f '%Lp' "$1" 2>/dev/null); then
    printf '%s\n' "$mode"
    return 0
  fi
  stat -c '%a' "$1" 2>/dev/null
}

# Portable symlink-resolving realpath (macOS/BSD has no `realpath -e`), used
# only by the private initial-question-file leg to canonicalize the seed path
# before it crosses the daemon re-invocation boundary. macOS spells a caller's
# /var/... scratch as canonical /private/var/...; this canonicalizes the
# target so the seed path stays byte-identical end to end.
invocation_canonical_file() {
  local path=$1 parent target count=0
  while [[ -L $path ]]; do
    (( count += 1 ))
    (( count <= 40 )) || return 1
    target=$(readlink "$path") || return 1
    if [[ $target == /* ]]; then
      path=$target
    else
      parent=${path%/*}
      [[ $path == */* ]] || parent=.
      [[ -n $parent ]] || parent=/
      path=$parent/$target
    fi
  done
  parent=${path%/*}
  if [[ $path != */* ]]; then
    parent=.
  elif [[ -z $parent ]]; then
    parent=/
  fi
  parent=$(CDPATH= cd -P -- "$parent" && pwd -P) || return 1
  if [[ $parent == / ]]; then
    printf '/%s\n' "${path##*/}"
  else
    printf '%s/%s\n' "$parent" "${path##*/}"
  fi
}

invocation_usage() {
  invocation_discard_scratch
  printf 'usage: review-%s [--mode MODE] <file.md>\n' "$invocation_name" >&2
  printf '   or: review-%s --allow-question [--mode MODE] <file.md>\n' "$invocation_name" >&2
  printf '   or: review-%s --answer-question [--run DIR] --for-question ID --text-file FILE\n' "$invocation_name" >&2
  printf '   or: review-%s --poll-question [--run DIR]\n' "$invocation_name" >&2
  printf '   or: review-%s --decline-question [--run DIR] --for-question ID --reason TEXT\n' "$invocation_name" >&2
  printf '   or: review-%s --review-v1 --actor ID --mode MODE <briefing-file>\n' "$invocation_name" >&2
  exit 2
}

# A one-file scratch is discarded whole when the lifecycle refuses before
# dispatch: nothing is published into it yet, and the guard keeps a published
# result out of the blast radius. A provider package is never discarded.
invocation_discard_scratch() {
  [[ ${invocation_created:-0} == 1 && ${invocation_profile:-one-file} == one-file ]] || return 0
  [[ ! -e ${invocation_result:-} && ! -L ${invocation_result:-} ]] || return 0
  rm -rf -- "$invocation_dir" 2>/dev/null || true
}

invocation_preflight_fail() {
  invocation_discard_scratch
  if [[ ${invocation_profile:-one-file} == explicit-briefing && ${invocation_created:-0} == 1 ]]; then
    printf 'review-%s: %s; retained provider package: %s\n' \
      "$invocation_name" "$1" "$invocation_dir" >&2
  else
    printf 'review-%s: %s\n' "$invocation_name" "$1" >&2
  fi
  exit "${2:-2}"
}

invocation_preserve_fail() {
  printf 'review-%s: %s; recoverable scratch: %s%s\n' \
    "$invocation_name" "$1" "$invocation_dir" "${invocation_residue:-}" >&2
  exit "${2:-1}"
}

invocation_prepare_initial_question() {
  local supplied=$1
  invocation_initial_question_file=$(invocation_canonical_file "$supplied") || \
    invocation_preflight_fail 'could not canonicalize the initial question file'
  [[ -f $invocation_initial_question_file && -r $invocation_initial_question_file ]] || \
    invocation_preflight_fail "initial question is not a readable regular file: $supplied"
  [[ $(invocation_path_mode "$invocation_initial_question_file" || true) == 600 ]] || \
    invocation_preflight_fail 'initial question file must have mode 0600'
  grep -q '[^[:space:]]' "$invocation_initial_question_file" || \
    invocation_preflight_fail 'initial question must be nonblank'
}

invocation_interrupted() {
  # Before dispatch this is a preflight refusal in every respect that matters,
  # so it reuses that path, which also names a retained provider package.
  if [[ ${invocation_dispatched:-0} == 0 ]]; then
    invocation_preflight_fail 'interrupted before launch' 130
  fi
  printf 'review-%s: interrupted; recoverable scratch: %s%s\n' \
    "$invocation_name" "$invocation_dir" "${invocation_residue:-}" >&2
  exit 130
}

invocation_note_host_failure() {
  local reason=$1 status=${2:-1}
  if [[ -z ${invocation_host_failure_reason:-} ]]; then
    invocation_host_failure_reason=$reason
    invocation_host_failure_status=$status
  else
    invocation_host_failure_reason="${invocation_host_failure_reason}; $reason"
  fi
}

# SUBSPACE_TUI_BIN is a caller-private override, not skill grammar: when set,
# it wins over PATH resolution so a build ahead of the installed release can
# be exercised without a Homebrew upgrade.
invocation_resolve_tui_bin() {
  if [[ -n ${SUBSPACE_TUI_BIN:-} ]]; then
    printf '%s\n' "$SUBSPACE_TUI_BIN"
  else
    command -v subspace-tui 2>/dev/null
  fi
}

# One token stands for the whole lifecycle and is probed once, before any host
# preflight and before any one-file scratch exists. The five scattered probes
# this replaces only multiplied the ways a stale binary could get part-way in
# before failing.
invocation_require_tui() {
  local found status
  found=$(invocation_resolve_tui_bin) || \
    invocation_preflight_fail 'subspace-tui is unavailable; read skills/r/references/subspace-tui-unavailable.md' 127
  [[ $found == /* ]] || invocation_preflight_fail 'subspace-tui did not resolve to an absolute path'
  [[ -f $found && -x $found ]] || \
    invocation_preflight_fail 'subspace-tui target is not an executable regular file'
  invocation_tui=$found
  set +e
  "$invocation_tui" --supports review-invocation-prepare-v1 >/dev/null 2>&1
  status=$?
  set -e
  [[ $status == 0 ]] || invocation_preflight_fail \
    'subspace-tui does not support review-invocation-prepare-v1; upgrade spacedock-dev/tap/subspace-beta' 127
}

# ---------------------------------------------------------------------------
# The question journey. The private Go command owns run identity, FIFO
# selection, claims, expiry and lifecycle observations. This file only
# validates the public dispatch shape and forwards the packet.
# ---------------------------------------------------------------------------

question_leg() {
  local verb=$1
  shift
  invocation_require_tui
  exec "$invocation_tui" --question-transport "$verb" "$@"
}

question_leg_arm() {
  local supplied= mode=feedback budget= launch_args seen_mode=0 seen_initial_question=0
  while [[ $# -gt 0 ]]; do
    case $1 in
      --mode)
        [[ $# -ge 2 ]] || invocation_usage
        [[ $seen_mode == 0 ]] || invocation_preflight_fail 'duplicate --mode'
        seen_mode=1
        mode=$2
        shift 2
        ;;
      --machine-budget)
        [[ $# -ge 2 ]] || invocation_usage
        budget=$2
        shift 2
        ;;
      --initial-question-file)
        [[ $# -ge 2 ]] || invocation_usage
        [[ $seen_initial_question == 0 ]] || invocation_preflight_fail 'duplicate --initial-question-file'
        seen_initial_question=1
        invocation_prepare_initial_question "$2"
        shift 2
        ;;
      -*) invocation_usage ;;
      *)
        [[ -z $supplied ]] || invocation_usage
        supplied=$1
        shift
        ;;
    esac
  done
  [[ -n $supplied ]] || invocation_usage
  [[ -z $budget || $budget =~ ^[0-9]+$ ]] || \
    invocation_preflight_fail "machine budget must be a whole number of seconds, not '$budget'"
  invocation_require_tui
  # Arming, detaching the daemon and waiting for its readiness are one
  # Go-owned op: internal/questiontransport.Launch. This adapter names the
  # daemon script and this entry, nothing more.
  launch_args=(--question-transport launch --daemon "$script_dir/review-question-daemon" \
    --entry "$0" --mode "$mode" --artifact "$supplied")
  if [[ -n $budget ]]; then
    launch_args+=(--machine-budget "$budget")
  fi
  if [[ -n ${invocation_initial_question_file:-} ]]; then
    launch_args+=(--initial-question-file "$invocation_initial_question_file")
  fi
  exec "$invocation_tui" "${launch_args[@]}"
}

# --invocation-prepare reports back through NUL records: state path, reason
# path, artifact directory, capsule, then the child argv the entries read.
invocation_read_prepared() {
  local record prepared=()
  # An unreadable report leaves prepared empty for the check below to refuse.
  while IFS= read -r -d '' record; do
    prepared+=("$record")
  done < "$1" 2>/dev/null || true
  [[ ${#prepared[@]} -ge 5 ]] || invocation_preflight_fail 'invocation preparation reported nothing usable'
  invocation_state=${prepared[0]}
  invocation_reason_file=${prepared[1]}
  invocation_artifact_dir=${prepared[2]}
  invocation_capsule=${prepared[3]}
  invocation_command=("${prepared[@]:4}")
}

invocation_allocate_scratch() {
  local scratch
  scratch=$(mktemp -d "$1") || invocation_preflight_fail "$2"
  invocation_dir=$(CDPATH= cd -- "$scratch" && pwd -P) || {
    rmdir -- "$scratch" 2>/dev/null || true
    invocation_preflight_fail "$3"
  }
  invocation_created=1
}

invocation_main() {
  [[ $# -ge 1 ]] || invocation_usage
  # The question legs reach a run directory and nothing else, so they are
  # dispatched before any host preflight and need no host.
  case ${1:-} in
    --allow-question) shift; question_leg_arm "$@"; return 0 ;;
    --answer-question) shift; question_leg answer "$@"; return 0 ;;
    --poll-question) shift; question_leg poll "$@"; return 0 ;;
    --decline-question) shift; question_leg decline "$@"; return 0 ;;
  esac

  local prepare_args dispatch_status host_status reason status prepared_out
  invocation_created=0
  invocation_dispatched=0
  invocation_residue=
  invocation_result=
  invocation_host_failure_reason=
  invocation_host_failure_status=0
  invocation_profile=one-file
  # Armed before any allocation: an interrupt before dispatch discards its scratch.
  trap invocation_interrupted HUP INT TERM

  umask 077
  if [[ ${1:-} == --review-v1 ]]; then
    invocation_profile=explicit-briefing
    # The package exists before the binary is resolved, so a provider gets its
    # diagnostic package back even when the presenter is missing or too old.
    # That puts allocation ahead of --invocation-prepare's grammar check, so
    # the gate deciding whether to allocate at all belongs here: an invocation
    # that was never well-formed must not leave a package behind.
    [[ $# == 6 && $2 == --actor && $4 == --mode ]] || invocation_usage
    invocation_allocate_scratch "${TMPDIR:-/tmp}/subspace-r-provider.XXXXXX" \
      'could not allocate provider package' 'could not resolve provider package'
    mkdir -- "$invocation_dir/diagnostics" || \
      invocation_preflight_fail 'could not create provider diagnostics'
    printf '%s\0' "$invocation_name" "$@" > "$invocation_dir/diagnostics/inputs.nul" || \
      invocation_preflight_fail 'could not stamp provider inputs'
  fi

  invocation_require_tui
  [[ -f $script_dir/validate-one-file-result && -x $script_dir/validate-one-file-result ]] || \
    invocation_preflight_fail 'canonical result validator is unavailable'

  if [[ $invocation_profile == one-file ]]; then
    invocation_allocate_scratch "${TMPDIR:-/tmp}/subspace-r.XXXXXX" \
      'could not create private invocation scratch' 'could not canonicalize private invocation scratch'
    invocation_result=$invocation_dir/result.json
  fi

  # Preparation runs before host preflight so every grammar and Artifact
  # refusal lands before the selected host is probed or launched.
  prepared_out=$invocation_dir/invocation-prepared.nul
  prepare_args=(--invocation-prepare --name "$invocation_name" --tui "$invocation_tui" \
    --dir "$invocation_dir" --out "$prepared_out")
  [[ ${invocation_async:-0} != 1 ]] || prepare_args+=(--async)
  prepare_args+=(--)
  set +e
  reason=$("$invocation_tui" "${prepare_args[@]}" "$@" 2>&1 >/dev/null)
  status=$?
  set -e
  [[ $status != 2 ]] || invocation_usage
  [[ $status == 0 ]] || invocation_preflight_fail "${reason:-invocation preparation failed}"
  invocation_read_prepared "$prepared_out"
  rm -f -- "$prepared_out"

  invocation_host_preflight

  invocation_dispatched=1
  set +e
  invocation_host_dispatch
  dispatch_status=$?
  set -e

  set +e
  "$invocation_tui" --invocation-finish --state "$invocation_state" \
    --dispatch-status "$dispatch_status" \
    --validator "$script_dir/validate-one-file-result" --reason-out "$invocation_reason_file"
  status=$?
  set -e
  reason=
  [[ ! -s $invocation_reason_file ]] || IFS= read -r reason < "$invocation_reason_file" || true
  # A non-zero completion whose reason never reached the file would otherwise
  # read as success here and be delivered as one.
  [[ $status == 0 || -n $reason ]] || reason='invocation completion failed'

  # The host's own completion hook runs whether or not the review succeeded,
  # and its failure joins the one reason line reported at the end.
  if declare -F invocation_host_complete >/dev/null; then
    set +e
    invocation_host_complete
    host_status=$?
    set -e
    if [[ $host_status != 0 ]]; then
      if [[ -z $reason ]]; then
        reason=${invocation_host_failure_reason:-host cleanup failed}
        status=${invocation_host_failure_status:-$host_status}
      else
        reason="$reason; ${invocation_host_failure_reason:-host cleanup failed}"
      fi
    fi
  fi

  # Cleanup runs strictly after that hook, so retention reflects the host's own
  # outcome. A failed review keeps its scratch, so this is reached only on success.
  if [[ -z $reason ]]; then
    set +e
    reason=$("$invocation_tui" --invocation-cleanup --state "$invocation_state")
    host_status=$?
    set -e
    if [[ $host_status == 0 ]]; then
      reason=
    else
      reason=${reason:-invocation cleanup failed}
      status=$host_status
    fi
  fi

  trap - HUP INT TERM
  [[ -z $reason ]] || invocation_preserve_fail "$reason" "$status"
}

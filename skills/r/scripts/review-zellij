#!/usr/bin/env bash
set -euo pipefail

invocation_name=zellij
invocation_async=0
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# shellcheck source=invocation-common
source "$script_dir/invocation-common"

# --placement is this entry's grammar alone. The pre-scan runs before
# invocation_main, so every refusal lands before any host probe or launch.
invocation_placement=right
invocation_placement_fail() {
  printf 'review-%s: %s\n' "$invocation_name" "$1" >&2
  exit 2
}
invocation_args=()
seen_placement=0
seen_armed=
while [[ $# -gt 0 ]]; do
  case $1 in
    --placement)
      [[ $# -ge 2 && $2 != -* ]] || \
        invocation_placement_fail '--placement requires a value: floating or right'
      [[ $seen_placement == 0 ]] || invocation_placement_fail 'duplicate --placement'
      seen_placement=1
      case $2 in
        floating|right) invocation_placement=$2 ;;
        *) invocation_placement_fail "unknown placement: $2" ;;
      esac
      shift 2
      ;;
    --allow-question|--review-v1) seen_armed=$1; invocation_args+=("$1"); shift ;;
    *) invocation_args+=("$1"); shift ;;
  esac
done
# Armed journeys re-invoke this entry with fixed argv and would silently drop
# placement, so the combination is refused by name.
[[ -z $seen_armed || $seen_placement == 0 ]] || \
  invocation_placement_fail "--placement cannot be combined with $seen_armed"
set -- ${invocation_args[@]+"${invocation_args[@]}"}

invocation_host_preflight() {
  zellij_bin=${SUBSPACE_ZELLIJ_BIN:-zellij}
  if [[ $zellij_bin != */* ]]; then
    zellij_bin=$(command -v -- "$zellij_bin") || invocation_preflight_fail 'Zellij is not installed' 127
  fi
  [[ -x $zellij_bin && ! -d $zellij_bin ]] || invocation_preflight_fail "Zellij is not executable: $zellij_bin"
  jq_bin=$(command -v jq) || invocation_preflight_fail 'jq is required to validate the Zellij pane inventory' 127
  local inventory status
  session=${ZELLIJ_SESSION_NAME:-}
  pane=${ZELLIJ_PANE_ID:-}
  [[ -n $session ]] || invocation_preflight_fail 'ZELLIJ_SESSION_NAME is required'
  [[ $pane =~ ^[0-9]+$ ]] || invocation_preflight_fail 'numeric ZELLIJ_PANE_ID is required'
  inventory=$("$zellij_bin" --session "$session" action list-panes --json --tab --state 2>/dev/null) || {
    status=$?
    invocation_preflight_fail "operation list-panes failed with status $status" "$status"
  }
  tab_id=$("$jq_bin" -er --argjson pane "$pane" '
    def valid_row:
      type == "object" and
      (.id | type) == "number" and (.id | floor) == .id and
      (.is_plugin | type) == "boolean" and
      (.exited | type) == "boolean" and
      (.tab_id | type) == "number" and (.tab_id | floor) == .tab_id and .tab_id >= 0;
    if type != "array" or (all(.[]; valid_row) | not) then
      error("invalid pane inventory")
    else
      [.[] | select(.id == $pane and .is_plugin == false and .exited == false)] |
      if length == 1 then .[0].tab_id else error("caller pane is not uniquely live") end
    end
  ' <<< "$inventory") || invocation_preflight_fail "caller pane terminal_$pane is not uniquely live"
}

invocation_host_dispatch() {
  invocation_residue='; operation: run'
  # Placement is a flag SUBSTITUTION, never an addition (--floating and
  # --direction are mutually exclusive); the spike falsified --near-current-pane.
  local placement=(--floating)
	if [[ $invocation_placement == right ]]; then
		placement=(--direction right)
	fi
	local child_command=("${invocation_command[@]}")
	if [[ ${SUBSPACE_TUI_DEMO_AUTO_REFRESH:-} == 1 ]]; then
		child_command=(/usr/bin/env SUBSPACE_TUI_DEMO_AUTO_REFRESH=1 "${child_command[@]}")
	fi
	"$zellij_bin" --session "$session" run \
    --tab-id "$tab_id" "${placement[@]}" --close-on-exit --block-until-exit \
    --cwd "$invocation_artifact_dir" -- \
		"${child_command[@]}" \
    >/dev/null 2>/dev/null
}

invocation_main "$@"
